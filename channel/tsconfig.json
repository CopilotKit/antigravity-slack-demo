{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@copilotkit/channels"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
